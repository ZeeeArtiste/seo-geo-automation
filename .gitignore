node_modules/
.env

# Les sites générés ne sont pas versionnés par défaut : ils sont reproductibles
# à partir du template et du pipeline.
sites/*

# Exception pour aspirob. La raison d'origine était l'intégration GitHub de
# Vercel, qui n'est plus utilisée : le site est hébergé sur le VPS (nginx +
# certbot, voir scripts/deploy-vps.js).
#
# L'exception reste néanmoins nécessaire, pour une autre raison : le contenu de
# ce site a été relu et corrigé à la main (suppression des données non vérifiées,
# liens affiliés placés un par un) et n'est donc PAS reproductible en relançant
# generate-content.js. Le dépôt en est la seule sauvegarde — le VPS n'en a aucune.
!sites/aspirob/

# Rapports d'audit générés : reproductibles via scripts/, inutile de les versionner
seo-audits/*.docx
seo-audits/*.pdf
