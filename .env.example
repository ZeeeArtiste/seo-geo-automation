# Obligatoire — génération des noms de domaine, articles, FAQ
ANTHROPIC_API_KEY=

# Optionnel — déploiement automatique sur Vercel
VERCEL_TOKEN=

# Optionnel — recherche/vérification/achat de domaine via Cloudflare Registrar API (beta)
# Voir README.md § Cloudflare Registrar pour la procédure de création du token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Tag Partenaires Amazon (ex: monsite-21) et boutique correspondante.
# Le tag et le domaine DOIVENT correspondre : un tag .co.uk sur un lien
# amazon.fr ne génère aucune commission.
AMAZON_ASSOCIATE_TAG=
AMAZON_ASSOCIATE_DOMAIN=www.amazon.fr

# Unsplash — clé d'accès publique, pour illustrer les articles
UNSPLASH_ACCESS_KEY=

# Awin — identifiant éditeur (Awin > Compte > Aperçu)
AWIN_PUBLISHER_ID=
