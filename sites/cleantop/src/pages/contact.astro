---
import Base from '../layouts/Base.astro';
import { SITE, LEGAL } from '../lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact — ${SITE.brand}`,
  url: new URL('/contact/', SITE.url).href,
  inLanguage: SITE.lang,
};
---
<Base
  title="Contact"
  description={`Contacter ${SITE.brand} : signaler une erreur, poser une question ou proposer une correction.`}
  jsonLd={[schema]}
>
  <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight mb-4">Contact</h1>
  <p class="text-lg text-body leading-relaxed mb-8 max-w-prose">
    Une erreur à signaler, une question sur un article, une demande de correction ?
  </p>

  <div class="border border-line rounded-sm bg-white p-6 mb-8">
    <p class="text-sm uppercase tracking-wide text-muted mb-2">Adresse e-mail</p>
    <p class="font-serif text-xl">
      <a href={`mailto:${LEGAL.contactEmail}`} class="text-accent underline underline-offset-4 decoration-accentSoft hover:decoration-accent">
        {LEGAL.contactEmail}
      </a>
    </p>
  </div>

  <p class="text-body leading-relaxed max-w-prose">
    Si vous signalez une information inexacte, indiquez si possible l'article concerné et la
    source qui la contredit : c'est ce qui nous permet de corriger vite. Les corrections sont
    appliquées directement dans l'article, et sa date de révision est mise à jour.
  </p>
</Base>
