---
/**
 * Fiche produit groupée : schéma, description, points forts / à savoir et
 * appel à l'action dans un seul bloc. Empilés séparément, ces éléments ne
 * disaient pas qu'ils parlaient du même produit.
 */
interface Props {
  product: {
    name: string; summary: string; schematic?: string; url?: string; sourceUrl?: string; affiliate?: boolean;
    pros: string[]; cons: string[];
    price?: number; priceCurrency?: string; priceSource?: string; priceCheckedAt?: string;
  };
  index?: number;
}
const { product: p, index } = Astro.props;
// Le libellé du bouton nomme le marchand : « Voir sur Amazon » dit où l'on
// atterrit, ce que « Voir le produit » cache. Déduit de l'URL, jamais supposé.
const marchand = p.url?.includes('amazon.') ? 'Amazon' : null;
---
<article class="produit">
  <div class="produit-tete">
    {index !== undefined && <span class="produit-num" aria-hidden="true">{index}</span>}
    <h3 id={p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>{p.name}</h3>
  </div>

  <div class="produit-corps">
    {p.schematic && (
      <div class="produit-schema">
        <img src={p.schematic} alt={`Schéma du ${p.name}`} width="640" height="190" loading="lazy" decoding="async" />
      </div>
    )}

    <div class="produit-texte">
      <p class="produit-resume">{p.summary}</p>

      {p.price !== undefined && (
        <p class="produit-prix">
          <strong>{p.price.toLocaleString('fr-FR', { style: 'currency', currency: p.priceCurrency ?? 'EUR', maximumFractionDigits: 2 })}</strong>
          <span>
            relevé le {new Date(p.priceCheckedAt ?? Date.now()).toLocaleDateString('fr-FR')}
            {p.priceSource && ' sur la '}
            {p.priceSource && (p.sourceUrl
              ? <a href={p.sourceUrl} rel="noopener" target="_blank">{p.priceSource}</a>
              : p.priceSource)}
            {' '}— il a pu changer depuis, et le prix du marchand peut différer
          </span>
        </p>
      )}

      {(p.pros.length > 0 || p.cons.length > 0) && (
        <div class="verdict">
          {p.pros.length > 0 && (
            <div><h4>Points forts</h4><ul class="plus">{p.pros.map((x) => <li>{x}</li>)}</ul></div>
          )}
          {p.cons.length > 0 && (
            <div><h4>À savoir</h4><ul class="minus">{p.cons.map((x) => <li>{x}</li>)}</ul></div>
          )}
        </div>
      )}

      {p.url && (
        <p class="produit-cta">
          {/* « sponsored » décrit une contrepartie financière. Sur un lien vers
              la boutique du fabricant, qui n'en rapporte aucune, l'annoncer
              serait faux — et Google traite la déclaration comme une donnée. */}
          <a href={p.url} rel={p.affiliate ? 'sponsored nofollow noopener' : 'noopener'} target="_blank">
            {p.affiliate
              ? (marchand ? `Voir ${p.name} sur ${marchand}` : `Voir ${p.name}`)
              : `Fiche officielle : ${p.name}`}
          </a>
        </p>
      )}
    </div>
  </div>
</article>
