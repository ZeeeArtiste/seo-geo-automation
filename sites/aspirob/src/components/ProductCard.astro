---
/**
 * Fiche produit groupée : schéma, description, points forts / à savoir et
 * liens d'achat dans un seul bloc. Empilés séparément, ces éléments ne
 * disaient pas qu'ils parlaient du même produit.
 */
interface Props {
  product: {
    name: string; summary: string; schematic?: string; url?: string; sourceUrl?: string;
    affiliate?: boolean; pros: string[]; cons: string[];
    price?: number; priceCurrency?: string; priceSource?: string; priceCheckedAt?: string;
  };
  index?: number;
}
const { product: p, index } = Astro.props;

// Le libellé nomme le marchand : « Amazon » dit où l'on atterrit, ce que
// « Voir le produit » cache. Déduit de l'URL, jamais supposé.
const marchand = p.url?.includes('amazon.') ? 'Amazon' : 'Le marchand';
const boutique = p.priceSource
  ? p.priceSource.charAt(0).toUpperCase() + p.priceSource.slice(1)
  : 'Boutique officielle';
const prix =
  p.price !== undefined
    ? p.price.toLocaleString('fr-FR', {
        style: 'currency',
        currency: p.priceCurrency ?? 'EUR',
        maximumFractionDigits: 2,
      })
    : null;
const releveLe = p.priceCheckedAt
  ? new Date(p.priceCheckedAt).toLocaleDateString('fr-FR')
  : null;
---
<article class="produit">
  <div class="produit-tete">
    {index !== undefined && <span class="produit-num" aria-hidden="true">{index}</span>}
    <h3 id={p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>{p.name}</h3>
  </div>

  <div class="produit-corps">
    {p.schematic && (
      <div class="produit-schema">
        <img src={p.schematic} alt={`Schéma du ${p.name}`} width="640" height="190" loading="lazy" decoding="async" />
      </div>
    )}

    <div class="produit-texte">
      <p class="produit-resume">{p.summary}</p>

      {(p.pros.length > 0 || p.cons.length > 0) && (
        <div class="verdict">
          {p.pros.length > 0 && (
            <div><h4>Points forts</h4><ul class="plus">{p.pros.map((x) => <li>{x}</li>)}</ul></div>
          )}
          {p.cons.length > 0 && (
            <div><h4>À savoir</h4><ul class="minus">{p.cons.map((x) => <li>{x}</li>)}</ul></div>
          )}
        </div>
      )}

      {/* Chaque prix appartient au lien qui le vend. Un tarif relevé chez le
          fabricant affiché au-dessus d'un bouton menant ailleurs laissait
          croire que c'était celui du marchand : les deux sont donc des lignes
          distinctes, et celle dont le prix n'est pas relevable l'annonce
          plutôt que d'emprunter celui de l'autre. */}
      {(p.url || p.sourceUrl) && (
        <div class="produit-achat">
          <p class="produit-achat-titre">Où acheter</p>
          <ul>
            {p.sourceUrl && (
              <li>
                <a href={p.sourceUrl} rel="noopener" target="_blank">{boutique}</a>
                <span class="produit-achat-prix">
                  {prix
                    ? <><strong>{prix}</strong>{releveLe && <small>relevé le {releveLe}</small>}</>
                    : <em>voir le prix</em>}
                </span>
              </li>
            )}
            {p.url && (
              <li class="est-principal">
                <a href={p.url} rel={p.affiliate ? 'sponsored nofollow noopener' : 'noopener'} target="_blank">
                  {marchand}
                </a>
                <span class="produit-achat-prix"><em>voir le prix</em></span>
              </li>
            )}
          </ul>
        </div>
      )}
    </div>
  </div>
</article>
