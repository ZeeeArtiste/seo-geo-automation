---
/**
 * Sommaire généré à partir des titres de niveau 2 de l'article.
 * Astro expose `headings` au rendu : rien n'est à maintenir à la main.
 *
 * `variant="rail"` rend la version collante en colonne latérale (grands
 * écrans) ; `variant="inline"` la version dans le flux (mobile et tablette).
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  variant?: 'inline' | 'rail';
}
const { headings, variant = 'inline' } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---
{items.length >= 3 && (
  <nav class={variant === 'rail' ? 'sommaire-rail' : 'sommaire'} aria-labelledby={`somm-${variant}`}>
    <p id={`somm-${variant}`} class="sommaire-titre">Sommaire</p>
    <ol>
      {items.map((h) => (
        <li><a href={`#${h.slug}`} data-somm={h.slug}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}
