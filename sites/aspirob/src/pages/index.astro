---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';
import { formatDateShort, readingTime } from '../lib/format';
import Hero from '../components/Hero.astro';
import credits from '../data/photo-credits.json';

const heroPhoto = (credits as Record<string, any>)['accueil'];

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// L'article mis en avant : celui marqué featured, sinon le comparatif le plus
// récent, sinon le plus récent tout court.
const featured =
  all.find((a) => a.data.featured) ??
  all.find((a) => a.data.category === 'Comparatif') ??
  all[0];
const rest = all.filter((a) => a.slug !== featured?.slug);

// Chaque entrée pointe vers un article existant : rien n'est promis qui
// n'existe pas sur le site.
const bySlug = (slug: string) => all.find((a) => a.slug === slug);
const usecases = [
  { label: "J'ai un chat ou un chien", hint: 'Le critère qui compte est la brosse.',
    href: '/articles/aspirateur-robot-poils-animaux-chat-chien/' },
  { label: 'Surtout du carrelage ou du parquet', hint: 'La question du lavage des sols.',
    href: '/articles/roomba-max-775-combo-vs-roborock-saros-10r/' },
  { label: 'Mon robot rate toujours les mêmes zones', hint: 'Angles morts et carte obsolète.',
    href: '/articles/navigation-lidar-aspirateur-robot-explication/' },
  { label: "Je ne sais pas quelle navigation choisir", hint: 'LiDAR ou caméra, les deux angles morts.',
    href: '/articles/navigation-lidar-camera-aspirateur-robot-differences/' },
].filter((u) => all.some((a) => `/articles/${a.slug}/` === u.href));

const comparatifs = rest.filter((a) => a.data.category === 'Comparatif');
const guides = rest.filter((a) => a.data.category !== 'Comparatif');
---
<Base
  title={`${SITE.brand} — ${SITE.tagline}`}
  description={SITE.description}
  ogType="website"
  rawTitle
>
  <section class="mb-16">
    <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1] mb-5">
      {SITE.tagline}
    </h1>
    <div class="w-12 h-px bg-accent mb-5"></div>
    <p class="text-lg text-body max-w-prose leading-relaxed">
      Comprendre ce qui sépare réellement deux aspirateurs robots — la navigation,
      le type de brosse, la station — plutôt que de comparer des fiches techniques.
      <span class="text-ink">Aucun chiffre que nous n'avons pas pu vérifier.</span>
    </p>
    {heroPhoto && <Hero photo={heroPhoto} eager class="mt-8 aspect-[3/2] sm:aspect-[21/9]" />}
  </section>


  <!-- Orientation par cas d'usage. Version honnête du « configurateur » qu'on
       trouve sur les comparateurs : elle oriente vers le bon article au lieu
       de prétendre calculer une recommandation à partir de specs qu'on n'a
       pas vérifiées. -->
  <section class="mb-16" aria-labelledby="par-ou">
    <h2 id="par-ou" class="text-xs font-medium tracking-[0.14em] uppercase text-accent mb-1">
      Par où commencer
    </h2>
    <p class="text-sm text-muted mb-5">Choisissez votre situation.</p>
    <div class="grid sm:grid-cols-2 gap-3">
      {usecases.map((u) => (
        <a
          href={u.href}
          class="group flex items-start gap-3 border border-line rounded-md bg-paper p-4 transition-colors hover:border-accent hover:bg-surface"
        >
          <span class="text-accent mt-0.5 shrink-0" aria-hidden="true">›</span>
          <span>
            <span class="block font-medium leading-snug group-hover:text-accent transition-colors">{u.label}</span>
            <span class="block text-sm text-muted mt-0.5">{u.hint}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {featured && (
    <section class="mb-16" aria-labelledby="a-la-une">
      <h2 id="a-la-une" class="text-xs font-medium tracking-[0.14em] uppercase text-accent mb-5">
        À la une
      </h2>
      <a href={`/articles/${featured.slug}/`} class="group block">
        <article class="border border-line rounded-sm bg-white overflow-hidden transition-colors group-hover:border-lineStrong">
          {featured.data.cover && (
            <img
              src={featured.data.cover}
              alt=""
              width="480"
              height="300"
              class="w-full h-40 sm:h-48 object-cover border-b border-line"
            />
          )}
          <div class="p-6 sm:p-8">
          <p class="text-xs tracking-wide uppercase text-muted mb-3">
            {featured.data.category}
          </p>
          <h3 class="font-serif text-2xl sm:text-3xl font-semibold tracking-tight leading-snug mb-3 group-hover:underline decoration-1 underline-offset-4 decoration-lineStrong">
            {featured.data.title}
          </h3>
          <p class="text-body leading-relaxed mb-4 max-w-prose">
            {featured.data.description}
          </p>
          <p class="text-sm text-muted">
            {formatDateShort(featured.data.publishDate)} · {readingTime(featured.body)} min de lecture
          </p>
          </div>
        </article>
      </a>
    </section>
  )}

  {comparatifs.length > 0 && (
    <section class="mb-14" aria-labelledby="comparatifs">
      <h2 id="comparatifs" class="text-xs font-medium tracking-[0.14em] uppercase text-accent mb-1">
        Comparatifs
      </h2>
      <p class="text-sm text-muted mb-5">Face-à-face entre modèles.</p>
      <ul class="divide-y divide-line border-t border-line">
        {comparatifs.map((a) => (
          <li>
            <a href={`/articles/${a.slug}/`} class="group flex gap-4 sm:gap-5 py-5 items-center">
              {a.data.cover ? (
                <img
                  src={a.data.cover}
                  alt=""
                  width="480"
                  height="300"
                  class="w-24 sm:w-32 h-16 sm:h-20 shrink-0 object-cover rounded-sm border border-line bg-white"
                />
              ) : (
                <span class="text-lineStrong group-hover:text-accent transition-colors" aria-hidden="true">›</span>
              )}
              <span class="flex-1">
                <span class="block font-serif text-lg sm:text-xl font-medium leading-snug group-hover:underline decoration-1 underline-offset-4 decoration-lineStrong">
                  {a.data.title}
                </span>
                <span class="block text-sm text-muted mt-1">
                  {formatDateShort(a.data.publishDate)} · {readingTime(a.body)} min
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {guides.length > 0 && (
    <section aria-labelledby="guides">
      <h2 id="guides" class="text-xs font-medium tracking-[0.14em] uppercase text-accent mb-1">
        Guides
      </h2>
      <p class="text-sm text-muted mb-5">Comprendre avant d'acheter.</p>
      <ul class="divide-y divide-line border-t border-line">
        {guides.map((a) => (
          <li>
            <a href={`/articles/${a.slug}/`} class="group flex gap-4 sm:gap-5 py-5 items-center">
              {a.data.cover ? (
                <img
                  src={a.data.cover}
                  alt=""
                  width="480"
                  height="300"
                  class="w-24 sm:w-32 h-16 sm:h-20 shrink-0 object-cover rounded-sm border border-line bg-white"
                />
              ) : (
                <span class="text-lineStrong group-hover:text-accent transition-colors" aria-hidden="true">›</span>
              )}
              <span class="flex-1">
                <span class="block font-serif text-lg sm:text-xl font-medium leading-snug group-hover:underline decoration-1 underline-offset-4 decoration-lineStrong">
                  {a.data.title}
                </span>
                <span class="block text-sm text-muted mt-1">
                  {formatDateShort(a.data.publishDate)} · {readingTime(a.body)} min
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
