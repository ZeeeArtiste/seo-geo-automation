---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';
import { formatDateShort, readingTime } from '../lib/format';

/** Une page par catégorie effectivement représentée : pas de page vide. */
export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  const cats = [...new Set(all.map((a) => a.data.category))];
  return cats.map((c) => ({
    params: { category: c.toLowerCase().replace(/[^a-z0-9]+/g, '-') + 's' },
    props: {
      category: c,
      articles: all
        .filter((a) => a.data.category === c)
        .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()),
    },
  }));
}

const { category, articles } = Astro.props;

/**
 * Chaque catégorie porte son propre texte : une page listant trois liens sous
 * une phrase générique n'a rien à dire à un moteur de recherche. La méta-
 * description vise la fenêtre de 150-160 caractères réellement affichée.
 */
const COPY: Record<string, { lede: string; body: string; meta: string; h2: string; seoTitle?: string }> = {
  Comparatif: {
    lede: 'Face-à-face entre modèles, sur les différences qui comptent vraiment.',
    body: "Nos comparatifs opposent deux appareils sur ce qui les sépare structurellement — la technologie employée, les composants qui s'usent, ce que chacun sait faire et ne sait pas faire — plutôt que sur des fiches techniques que personne ne peut vérifier. Vous n'y trouverez pas de note sur dix : nous ne testons pas les produits. Les prix affichés, eux, sont relevés chez le fabricant, datés et attribués — jamais estimés.",
    meta: "Comparatifs : {{NICHE}}. Les différences structurelles entre modèles, sans note ni chiffre inventé.",
    h2: 'Tous nos comparatifs',
    seoTitle: "Comparatifs : {{NICHE}}",
  },
  Guide: {
    lede: "Comprendre le sujet avant d'acheter.",
    body: "Nos guides expliquent le fonctionnement de ce que vous achetez : comment la technologie marche réellement, pourquoi certains problèmes reviennent toujours, ce qui distingue deux composants qui se ressemblent. Ce sont les critères qui restent valables d'une génération de produits à la suivante, contrairement aux arguments commerciaux.",
    meta: "Guides : {{NICHE}}. Le fonctionnement et les critères de choix expliqués simplement avant d'acheter.",
    h2: 'Tous nos guides',
    seoTitle: "Guides d'achat : {{NICHE}}",
  },
  Test: { lede: 'Nos retours détaillés.', body: '', meta: 'Nos retours détaillés.', h2: 'Tous nos tests' },
  Actualité: { lede: 'Ce qui bouge dans la catégorie.', body: '', meta: 'Ce qui bouge dans la catégorie.', h2: 'Toute l\'actualité' },
};
const copy = COPY[category] ?? { lede: '', body: '', meta: `${category}s ${SITE.brand}.`, h2: `Tous nos ${category.toLowerCase()}s` };
---
<Base
  title={copy.seoTitle ?? `${category}s`}
  description={copy.meta}
>
  <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight mb-3">{category}s</h1>
  <p class="text-lg text-muted mb-5 max-w-prose">{copy.lede}</p>
  {copy.body && <p class="text-body leading-relaxed mb-10 max-w-prose">{copy.body}</p>}

  <h2 class="text-xs font-medium tracking-[0.14em] uppercase text-accent mb-5">{copy.h2}</h2>

  <ul class="divide-y divide-line border-t border-line">
    {articles.map((a) => (
      <li>
        <a href={`/articles/${a.slug}/`} class="group flex gap-4 sm:gap-5 py-5 items-center">
          {a.data.cover ? (
            <img src={a.data.cover} alt="" width="480" height="300"
                 class="w-24 sm:w-32 h-16 sm:h-20 shrink-0 object-cover rounded-sm border border-line bg-surface" />
          ) : (
            <span class="text-lineStrong group-hover:text-accent transition-colors" aria-hidden="true">›</span>
          )}
          <span class="flex-1">
            <span class="block font-serif text-lg sm:text-xl font-medium leading-snug group-hover:underline decoration-1 underline-offset-4 decoration-lineStrong">
              {a.data.title}
            </span>
            <span class="block text-sm text-muted mt-1">
              {formatDateShort(a.data.publishDate)} · {readingTime(a.body)} min
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
