---
import Base from '../../layouts/Base.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import Hero from '../../components/Hero.astro';
import Sommaire from '../../components/Sommaire.astro';
import Essentiel from '../../components/Essentiel.astro';
import FinArticle from '../../components/FinArticle.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import credits from '../../data/photo-credits.json';
import { getCollection } from 'astro:content';
import { SITE, AUTHOR } from '../../lib/site';
import { formatDate, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  // Un draft ne produit aucune page : donc absent du site ET du sitemap.
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, all: articles },
  }));
}

const { article, all } = Astro.props;
const photo = (credits as Record<string, any>)[article.slug];
const { Content, headings } = await article.render();
const { data } = article;

const url = new URL(`/articles/${article.slug}/`, SITE.url).href;
const minutes = readingTime(article.body);

// Articles liés : même catégorie d'abord, complété par les plus récents.
const others = all.filter((a) => a.slug !== article.slug);
// Le sujet prime sur le format : un lecteur qui termine un article sur le
// LiDAR veut un autre article sur la navigation, pas n'importe quel comparatif.
// `category` reste le départage secondaire.
const related = [
  ...others.filter((a) => data.cluster && a.data.cluster === data.cluster),
  ...others.filter(
    (a) => !(data.cluster && a.data.cluster === data.cluster) && a.data.category === data.category
  ),
  ...others.filter(
    (a) => !(data.cluster && a.data.cluster === data.cluster) && a.data.category !== data.category
  ),
].slice(0, 3);

const suite = related.slice(0, 2).map((a) => ({
  href: `/articles/${a.slug}/`,
  label: a.data.title,
  hint: a.data.category,
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

// BlogPosting : identifie l'article, son auteur et ses dates. Absent jusqu'ici,
// c'est pourtant le schéma central pour un site éditorial.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  inLanguage: SITE.lang,
  datePublished: data.publishDate,
  dateModified: data.updatedDate ?? data.publishDate,
  author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  articleSection: data.category,
  // Une image aide la reprise en résultat enrichi et en citation IA.
  image: [new URL(`/og-${article.slug}.png`, SITE.url).href],
};

// Un Product n'est éligible au résultat enrichi que s'il porte une offre.
// On n'en génère donc que pour les produits dont le prix a été RELEVÉ.
const productSchemas = data.products
  .filter((p) => p.price !== undefined)
  .map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: p.summary,
    ...(p.schematic ? { image: [new URL(p.schematic, SITE.url).href] } : {}),
    offers: {
      '@type': 'Offer',
      price: p.price,
      priceCurrency: p.priceCurrency ?? 'EUR',
      // Date au-delà de laquelle le prix ne doit plus être présenté comme valide.
      priceValidUntil: new Date(
        new Date(p.priceCheckedAt ?? Date.now()).getTime() + 30 * 864e5
      ).toISOString().slice(0, 10),
      availability: 'https://schema.org/InStock',
      // L'URL de l'offre est celle où CE prix est pratiqué, pas le lien
      // d'affiliation. Annoncer un tarif relevé chez le fabricant en le
      // rattachant à la fiche d'un autre marchand est un écart que Google
      // vérifie, et c'est surtout faux.
      ...(p.sourceUrl ?? p.url ? { url: p.sourceUrl ?? p.url } : {}),
      ...(p.priceSource
        ? { seller: { '@type': 'Organization', name: p.priceSource } }
        : {}),
    },
  }));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    // La catégorie pointait vers l'accueil : la hiérarchie déclarée était plate.
    {
      '@type': 'ListItem',
      position: 2,
      name: data.category,
      item: new URL(`/${data.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}s/`, SITE.url).href,
    },
    { '@type': 'ListItem', position: 3, name: data.title, item: url },
  ],
};
---
<Base
  title={data.seoTitle ?? data.title}
  description={data.description}
  ogType="article"
  ogImage={`/og-${article.slug}.png`}
  wide
  jsonLd={[articleSchema, breadcrumbSchema, faqSchema, ...productSchemas]}
>
  <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10 xl:gap-14">
    <!-- Colonne latérale : sommaire collant, masqué sous lg où la version
         dans le flux prend le relais. -->
    <aside class="hidden lg:block">
      <Sommaire headings={headings} variant="rail" />
    </aside>

    <div class="min-w-0 max-w-3xl">
  <nav aria-label="Fil d'Ariane" class="mb-8 text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-ink underline underline-offset-4 decoration-lineStrong">Accueil</a></li>
      <li aria-hidden="true" class="text-lineStrong">/</li>
      <li class="text-body">{data.category}</li>
    </ol>
  </nav>

  <article>
    {photo && <Hero photo={photo} eager class="mb-7" />}

    <header class="mb-7">
      <h1 class="font-serif text-3xl md:text-4xl font-semibold tracking-tight leading-[1.15] mb-4">
        {data.title}
      </h1>
      <p class="text-sm text-muted flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>Par {AUTHOR.name}</span>
        <span aria-hidden="true" class="text-lineStrong">·</span>
        <time datetime={data.publishDate}>{formatDate(data.publishDate)}</time>
        {data.updatedDate && (
          <>
            <span aria-hidden="true" class="text-lineStrong">·</span>
            <span>mis à jour le <time datetime={data.updatedDate}>{formatDate(data.updatedDate)}</time></span>
          </>
        )}
        <span aria-hidden="true" class="text-lineStrong">·</span>
        <span>{minutes} min de lecture</span>
      </p>
    </header>

    <!-- Réponse directe : ce paragraphe est ce que les moteurs génératifs
         (ChatGPT, Perplexity) citent en priorité. -->
    <Essentiel text={data.directAnswer} />

    <div class="lg:hidden"><Sommaire headings={headings} /></div>

    {data.products.length > 0 && (
      <section class="mb-12" aria-labelledby="modeles">
        <h2 id="modeles" class="font-serif text-2xl font-semibold tracking-tight mb-4">
          {data.products.length > 2 ? 'Les modèles retenus' : 'Les deux modèles face à face'}
        </h2>
        <ComparisonTable
          products={data.products}
          caption="Comparatif des caractéristiques structurelles — aucune donnée non vérifiée."
        />
        <div class="produits">
          {data.products.map((p, i) => (
            <ProductCard product={p} index={data.products.length > 2 ? i + 1 : undefined} />
          ))}
        </div>
        {/* Seulement si au moins une fiche porte un lien rémunéré. Des liens
            vers les boutiques des fabricants ne rapportent rien : annoncer une
            commission au-dessus d'eux serait une fausse déclaration, aussi
            fautive que l'omission inverse. */}
        {data.products.some((p) => p.affiliate) && <AffiliateDisclosure />}
      </section>
    )}

    <div class="prose prose-lg max-w-none
                prose-headings:font-serif prose-headings:font-semibold prose-headings:tracking-tight
                prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
                prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                prose-p:text-body prose-p:leading-[1.75]
                prose-li:text-body prose-li:leading-[1.7]
                prose-strong:text-ink prose-strong:font-semibold
                prose-a:text-accent prose-a:underline prose-a:underline-offset-2 prose-a:decoration-accentSoft
                hover:prose-a:decoration-accent
                prose-hr:border-line prose-hr:my-10
                prose-table:text-[0.95em] prose-th:bg-surface prose-th:font-medium
                prose-td:border-line prose-th:border-line
                prose-blockquote:border-l-accent prose-blockquote:text-body prose-blockquote:font-normal prose-blockquote:not-italic">
      <Content />
    </div>

    <!-- Divulgation pour les articles dont les liens affiliés sont dans le
         corps du texte plutôt que dans des fiches produit. Elle était
         auparavant imbriquée dans le bloc fiches : les guides, qui n'en ont
         pas, affichaient des liens rémunérés SANS divulgation. -->
    {data.affiliate && !data.products.some((p) => p.affiliate) && <AffiliateDisclosure />}

    {data.faq.length > 0 && (
      <section class="mt-14 pt-8 border-t border-line" aria-labelledby="faq">
        <h2 id="faq" class="font-serif text-2xl font-semibold tracking-tight mb-6">
          Questions fréquentes
        </h2>
        <div class="border-t border-line">
          {data.faq.map((item, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{item.question}</summary>
              <div class="answer">{item.answer}</div>
            </details>
          ))}
        </div>
      </section>
    )}
  </article>

  <FinArticle links={suite} />

  {related.length > 0 && (
    <aside class="mt-14 pt-8 border-t border-line" aria-labelledby="lire-aussi">
      <h2 id="lire-aussi" class="text-xs font-medium tracking-[0.14em] uppercase text-accent mb-5">
        À lire aussi
      </h2>
      <ul class="divide-y divide-line border-t border-line">
        {related.map((a) => (
          <li>
            <a href={`/articles/${a.slug}/`} class="group flex gap-4 py-4 items-baseline">
              <span class="text-lineStrong group-hover:text-accent transition-colors" aria-hidden="true">›</span>
              <span class="flex-1">
                <span class="block font-serif text-lg font-medium leading-snug group-hover:underline decoration-1 underline-offset-4 decoration-lineStrong">
                  {a.data.title}
                </span>
                <span class="block text-sm text-muted mt-0.5">{a.data.category}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )}
    </div>
  </div>

  <script>
    // Suivi de lecture : met en avant la section visible dans le sommaire.
    const links = document.querySelectorAll('.sommaire-rail a[data-somm]');
    if (links.length) {
      const map = new Map(
        [...links].map((a) => [a.getAttribute('data-somm'), a])
      );
      const targets = [...map.keys()]
        .map((id) => document.getElementById(id))
        .filter(Boolean);
      let current = null;
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              if (current) current.classList.remove('is-active');
              current = map.get(e.target.id) ?? null;
              if (current) current.classList.add('is-active');
            }
          }
        },
        { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
      );
      targets.forEach((t) => obs.observe(t));
    }
  </script>
</Base>
